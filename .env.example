# ========================================================
# NextGen AR/VR Cloud Database & Live Notification Settings
# ========================================================

# Option 1: Standard PostgreSQL (Render Database, Supabase, Neon, Railway)
# Paste your connection string below:
DATABASE_URL=postgresql://postgres:your_password@ep-xyz.render.com/nextgen_db

# Option 2: Supabase Cloud API (Alternative)
# Found in Supabase Project Settings -> API:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Option 3: Real-Time Discord / Webhook Alerts (Optional)
# Paste a Discord or Slack Webhook URL to get pinged on your phone whenever someone applies or registers!
NOTIFICATION_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Security Secrets
JWT_SECRET=NextGen_Secret_XR_2026_Key!
PORT=5000
