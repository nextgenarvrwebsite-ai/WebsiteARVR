# ==========================================
# NextGen AR/VR Portal - Server Environment
# ==========================================

# Server Port (Render sets this automatically to 10000)
PORT=5000
NODE_ENV=production

# JWT Authentication Secret for Admin Portal
JWT_SECRET=nextgen-arvr-portal-super-secret-key-2026

# ==========================================
# MongoDB Atlas Database Connection (Render)
# ==========================================
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:YOUR_PASSWORD@cluster0.abcde.mongodb.net/nextgen_portal?retryWrites=true&w=majority

# ==========================================
# Optional: Alternative Cloud Providers
# ==========================================
# Supabase PostgreSQL (if using Supabase instead of MongoDB)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_KEY=your-anon-key

# Optional: Instant notifications (Discord webhook)
# NOTIFICATION_WEBHOOK_URL=https://discord.com/api/webhooks/...
